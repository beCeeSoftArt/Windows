ProductName=NDOW
ProductVersion=1.0.0.0
Comments=Only Free For Non Commercial Usage. 
Kontakt=bcare@t-online.de

[Debugging]
DebugSourceDirs=$(BCB)\source\vcl

[Parameters]
RunParams=
HostApplication=
RemoteHost=
RemotePath=
RemoteDebug=0

[Compiler]
ShowInfoMsgs=0
LinkDebugVcl=1
  </IDEOPTIONS>
</PROJECT>